# === General errors and messages ===
msgid "Erro de segurança: nonce inválido ou expirado."
msgstr "Security error: invalid or expired nonce."

msgid "Falha de segurança."
msgstr "Security failure."

msgid "Carrinho vazio ou dados inválidos."
msgstr "Empty cart or invalid data."

msgid "Nenhum item encontrado."
msgstr "No items found."

msgid "Nenhum produto encontrado."
msgstr "No products found."

msgid "Produto inválido."
msgstr "Invalid product."

msgid "Produto adicionado ao carrinho."
msgstr "Product added to cart."

msgid "Produto removido do carrinho."
msgstr "Product removed from cart."

msgid "Carrinho está vazio."
msgstr "Cart is empty."

msgid "Número de WhatsApp não configurado."
msgstr "WhatsApp number not configured."

msgid "IDs de produtos não enviados."
msgstr "Product IDs not provided."

# === Front-end popup ===
msgid "Seu Carrinho"
msgstr "Your Cart"

msgid "Enviar Orçamento via WhatsApp"
msgstr "Send Quote via WhatsApp"

msgid "Remover"
msgstr "Remove"

# === Admin Settings Page ===
msgid "Configurações sbp"
msgstr "SBP Settings"

msgid "Configurações do Simple Budget Plugin"
msgstr "Simple Budget Plugin Settings"

msgid "Configurações do WhatsApp"
msgstr "WhatsApp Settings"

msgid "Número de WhatsApp"
msgstr "WhatsApp Number"

msgid "Tipos de Conteúdo"
msgstr "Content Types"

msgid "Insira o número de WhatsApp (DDD + 9 + número [se for fixo, retirar o 9; DDD + Número])."
msgstr "Enter the WhatsApp number (Area code + 9 + number [for landlines, remove the 9; Area code + Number])."

msgid "Insira o número de WhatsApp (apenas dígitos, com DDD). Ex.: 11999998888"
msgstr "Enter the WhatsApp number (digits only, with area code). E.g., 11999998888"

msgid "Deixe em branco para aceitar qualquer post type. Para restringir, informe os slugs (um por linha)."
msgstr "Leave it blank to accept any post type. To restrict it, enter the slugs (one per line)."

# === Shortcode [sbp_cart] ===
msgid "Erro ao carregar o carrinho."
msgstr "Error loading the cart."

msgid "Seu carrinho está vazio."
msgstr "Your cart is empty."

# === JavaScript (popup, cart and WhatsApp) ===
msgid "Erro: Popup do carrinho não foi encontrado na página."
msgstr "Error: Cart popup was not found on the page."

msgid "Aviso: Popup já está fechado."
msgstr "Warning: Popup is already closed."

msgid "Carrinho vazio ou inexistente no localStorage."
msgstr "Cart empty or missing in localStorage."

msgid "Erro ao tentar parsear o carrinho:"
msgstr "Error trying to parse the cart:"

msgid "Erro: Tentativa de salvar um carrinho inválido no localStorage."
msgstr "Error: Attempt to save an invalid cart in localStorage."

msgid "Produto adicionado ao carrinho!"
msgstr "Product added to cart!"

msgid "Produto já está no carrinho!"
msgstr "Product is already in the cart!"

msgid "Erro ao adicionar o produto ao carrinho."
msgstr "Error adding product to cart."

msgid "Erro: Número de WhatsApp não configurado."
msgstr "Error: WhatsApp number not configured."

msgid "Erro ao gerar a mensagem do WhatsApp."
msgstr "Error generating WhatsApp message."

msgid "Olá! Eu quero fazer um orçamento dos seguintes produtos:\\n"
msgstr "Hello! I would like to request a quote for the following products:\\n"
